{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youaskm3.local/contracts/persona-registry.schema.json",
  "title": "Persona Registry",
  "type": "object",
  "required": ["schema_version", "active_persona_id", "personas", "shared_scopes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "active_persona_id": {
      "type": "string",
      "minLength": 1
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["persona_id", "label", "assistant_metadata"],
        "additionalProperties": false,
        "properties": {
          "persona_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "assistant_metadata": {
            "type": "object",
            "required": ["role", "allowed_shared_scopes"],
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "allowed_shared_scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "shared_scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope_id", "label", "allowed_persona_ids", "conflict_policy"],
        "additionalProperties": false,
        "properties": {
          "scope_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "allowed_persona_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "conflict_policy": {
            "enum": ["surface", "block"]
          }
        }
      }
    }
  }
}
